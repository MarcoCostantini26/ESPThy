<!DOCTYPE aesl-source>
<network>


<!--list of global events-->


<!--node Dispositivo seriale USB-->
<node name="Dispositivo seriale USB" nodeId="{3e20a056-7981-4dfd-9c0b-dde67f8c18ba}"><![CDATA[onevent rc5
if rc5.command == 1 then
    # RED
    call leds.top(32, 0, 0)
    motor.left.target = 0
    motor.right.target = 0
elseif rc5.command == 2 then
    # GREEN
    call leds.top(0, 32, 0)
    motor.left.target = 80
    motor.right.target = 80
elseif rc5.command == 3 then
    # BLUE
    call leds.top(0, 0, 32)
    motor.left.target = 80
    motor.right.target = -80
elseif rc5.command == 5 then
    # WHITE
    call leds.top(32, 32, 32)
    motor.left.target = -150
    motor.right.target = -150
elseif rc5.command == 4 then
    # BLACK 
    call leds.top(0, 0, 0)
    motor.left.target = 0
    motor.right.target = 0
end]]></node>


</network>
